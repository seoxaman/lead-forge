# Copy this file to .env.local for local dev. On Vercel, add these as Environment Variables.

# Get from https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get this AFTER you run your first Apify Google Maps scrape (see README step 3)
APIFY_DATASET_ID=xxxxxxxxxxxxxxxxx

# Default actor for triggering new scrapes (Google Maps Scraper by compass)
APIFY_ACTOR_ID=compass~crawler-google-places
